---
const year = new Date().getUTCFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <p class="mono">Abby + David · St. Louis, Missouri</p>
    <ul class="links mono">
      <li><a href="https://abbydavid.com/">abbydavid.com</a></li>
      <li><a href="/projects/">All projects</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
    <p class="mono">© {year}</p>
  </div>
</footer>

<style>
  .site-footer { margin-top: clamp(4rem, 10vw, 7rem); padding: 1.75rem 0 2.5rem; border-top: 1px solid var(--rule); }
  .site-footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.5rem 2rem; }
  .site-footer p { margin: 0; }
  .links { display: flex; flex-wrap: wrap; gap: 0 1.25rem; list-style: none; margin: 0; padding: 0; }
  .links a { display: inline-block; padding-block: 0.6rem; }
</style>
