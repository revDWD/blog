---
import type { Project } from "../lib/content";
import ProjectCard from "./ProjectCard.astro";
interface Props { projects: Project[]; level?: 2 | 3 }
const { projects, level = 3 } = Astro.props;
---
<div class="grid" data-grid>
  {projects.map((p, i) => <ProjectCard project={p} level={level} eager={i < 2} />)}
</div>
<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: clamp(2.5rem, 5vw, 3.5rem) clamp(1.75rem, 4vw, 3rem); }
</style>
