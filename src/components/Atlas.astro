---
import SkyView from "./SkyView.astro";
import StarGlyph from "./StarGlyph.astro";
import StatusPill from "./StatusPill.astro";
import { frame, GLYPH_LABEL, type Atlas, type Glyph } from "../lib/atlas";
import { no } from "../lib/content";

interface Props { atlas: Atlas }
const { atlas } = Astro.props;
const present = (["bench", "survey", "idea", "complete", "evolving", "paused"] as Glyph[]).filter((g) =>
  atlas.stars.some((s) => s.glyph === g),
);
const pulse = atlas.stars.find((s) => s.pulse);
const top = (field: string) =>
  atlas.stars.filter((s) => s.field === field).sort((a, b) => +new Date(b.updated) - +new Date(a.updated));
---
<section class="atlas" aria-labelledby="atlas-title">
  <div class="atlas-intro wrap-wide">
    <p class="eyebrow mono">The Abby + David workshop</p>
    <h1 id="atlas-title">Everything we make, <em>charted as stars.</em></h1>
    <p class="sub">
      Each constellation is a field. Each star is a project: the bigger it is, the deeper it goes, and
      the <span class="coral">coral</span> one is on the bench right now.
    </p>
    <p class="alt-route mono"><a href="#ledger">Read it as a list instead ↓</a></p>
    <p class="since mono" data-since hidden></p>
  </div>

  <div class="atlas-stage wrap-wide" data-atlas data-pulse={pulse?.id}>
    <div class="atlas-frame">
      <SkyView atlas={atlas} interactive cartouche label={`Atlas of the workshop: ${atlas.stars.length} entries in ${atlas.constellations.length} constellations`} describedBy="atlas-help" />

      <div class="card" data-card aria-hidden="true" hidden>
        <p class="card-meta mono"><span data-c-no></span> · <span data-c-field></span></p>
        <p class="card-title" data-c-title></p>
        <p class="card-dek" data-c-dek></p>
        <p class="card-foot mono"><span class="card-status" data-c-status></span><span class="card-open">Open dossier →</span></p>
      </div>

      <div class="atlas-bar">
        <ul class="legend mono" aria-label="Key">
          {present.map((g) => (
            <li>
              <svg viewBox="-13 -13 26 26" aria-hidden="true" class:list={[{ coral: g === "bench" }]}><StarGlyph glyph={g} r={6} /></svg>
              {GLYPH_LABEL[g]}
            </li>
          ))}
        </ul>
        <button type="button" class="reset mono" data-reset hidden>↺ Whole sky</button>
      </div>
    </div>
    <p id="atlas-help" class="atlas-help mono">
      <span class="kb">Tab into the chart, then use the arrow keys to move between stars · <kbd>[</kbd> <kbd>]</kbd> jump between constellations · <kbd>Esc</kbd> zooms out.</span>
    </p>

    <nav class="fly" aria-label="Fly to a constellation">
      <span class="mono fly-label" aria-hidden="true">Fly to</span>
      <ul>
        {atlas.constellations.map((c) => (
          <li><a href={`/fields/${c.id}/`} data-fly={c.id}>{c.name}<span class="visually-hidden">, </span><span class="mono">{c.count}<span class="visually-hidden"> {c.count === 1 ? "entry" : "entries"}</span></span></a></li>
        ))}
      </ul>
    </nav>
    {atlas.uncharted.length > 0 && (
      <p class="uncharted mono">Uncharted so far: {atlas.uncharted.map((u) => u.name).join(", ")}.</p>
    )}
  </div>

  <!-- Phones: the whole sky as a thumbnail, then one strip per constellation (no scroll trap). -->
  <ol class="strips wrap-wide" aria-label="Constellations">
    {atlas.constellations.map((c) => {
      const list = top(c.id);
      return (
        <li class="strip">
          <SkyView atlas={atlas} decorative grid={false} viewBox={frame(c, 1.35, 1.6, 230)} focusField={c.id} isolate class="strip-sky" />
          <div class="strip-body">
            <h2 class="strip-h"><a href={`/fields/${c.id}/`}>{c.name}</a> <span class="mono">{c.count === 1 ? "1 star" : `${c.count} stars`}</span></h2>
            <ul>
              {list.slice(0, 3).map((s) => (
                <li>
                  <a href={s.href}><span class="mono">{no(s.no)}</span> {s.title}</a>
                  <StatusPill status={s.status} class="mono" />
                </li>
              ))}
            </ul>
            {list.length > 3 && <a class="mono all" href={`/fields/${c.id}/`}>All {list.length} in {c.name} →</a>}
          </div>
        </li>
      );
    })}
  </ol>
</section>

<script>
  import { initAtlas } from "../scripts/atlas";
  initAtlas();
</script>

<style>
  .atlas-intro { padding: clamp(1.75rem, 4.5vw, 3.25rem) 0 clamp(1rem, 2.5vw, 1.5rem); display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 0.5rem 3rem; align-items: end; }
  .eyebrow { grid-column: 1 / -1; margin: 0; }
  h1 {
    font-family: var(--serif); font-weight: 300; font-size: clamp(2.5rem, 1.3rem + 4vw, 4.6rem);
    line-height: 1; letter-spacing: -0.025em; margin: 0; text-wrap: balance; max-width: 19ch;
  }
  h1 em { font-style: italic; text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 0.045em; text-underline-offset: 0.14em; text-decoration-skip-ink: auto; }
  .sub { font-family: var(--serif); font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.35rem); line-height: 1.45; color: var(--muted); margin: 0 0 0.4rem; max-width: 30rem; text-wrap: pretty; }
  .coral { color: var(--coral); }
  .alt-route { grid-column: 2; margin: 0; }
  .alt-route a { display: inline-block; padding-block: 0.4rem; }
  .since { grid-column: 1 / -1; margin: 0.5rem 0 0; padding-top: 0.6rem; border-top: 1px solid var(--rule); color: var(--ink); }
  .since :global(a) { color: var(--accent); }

  .atlas-frame { position: relative; border: 1px solid var(--edge); background: var(--paper); }
  .atlas-frame :global(.sky) { aspect-ratio: 16 / 10; }
  .atlas-frame :global(.star) { cursor: pointer; outline: none; }
  .atlas-frame :global(.star:focus-visible .hit) { stroke: var(--accent); stroke-width: 2.5; stroke-dasharray: 3 3; }
  .atlas-frame :global(.sky.has-hot .star:not(.is-hot):not(.is-kin)) { opacity: 0.42; transition: opacity 0.3s ease; }
  .atlas-frame :global(.sky .star) { transition: opacity 0.3s ease; }
  .atlas-frame :global(.star.is-hot .s-label), .atlas-frame :global(.star.is-kin .s-label), .atlas-frame :global(.is-zoomed .s-label) { opacity: 1; }
  .atlas-frame :global(.thread.is-on) { opacity: 1; }
  .atlas-frame :global(.c-label:hover .c-name) { fill: var(--accent); }

  .card {
    position: absolute; z-index: 3; width: min(20rem, 70vw); padding: 0.9rem 1rem 0.8rem;
    background: var(--surface); border: 1px solid var(--edge); box-shadow: 6px 6px 0 -1px var(--paper-deep), 6px 6px 0 0 var(--rule);
    pointer-events: auto; cursor: pointer; transition: opacity 0.2s ease, transform 0.3s var(--ease-out);
  }
  .card[hidden] { display: block; opacity: 0; pointer-events: none; transform: translateY(4px); visibility: hidden; }
  .card p { margin: 0; }
  .card-meta { color: var(--muted); }
  .card-title { font-family: var(--serif); font-size: 1.4rem; line-height: 1.15; margin: 0.25rem 0 0.35rem !important; }
  .card-dek { font-size: 0.95rem; line-height: 1.45; color: var(--muted); }
  .card-foot { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.7rem !important; padding-top: 0.55rem; border-top: 1px solid var(--rule); }
  .card-open { color: var(--accent); }
  .card-status[data-bench] { color: var(--coral); }

  .atlas-bar { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem 1.5rem; flex-wrap: wrap; padding: 0.55rem 0.9rem; border-top: 1px solid var(--rule); background: var(--paper-deep); }
  .legend { display: flex; flex-wrap: wrap; gap: 0.2rem 1.25rem; list-style: none; margin: 0; padding: 0; }
  .legend li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .legend svg { width: 1.15rem; height: 1.15rem; color: var(--chart-ink); overflow: visible; }
  .legend svg.coral { color: var(--coral); }
  .reset { background: none; border: 1px solid var(--edge); color: var(--ink); padding: 0.35rem 0.75rem; min-height: 2.25rem; cursor: pointer; border-radius: 2px; }
  .reset:hover { color: var(--accent); border-color: var(--accent); }

  .atlas-help { margin: 0.6rem 0 0; }
  kbd { font-family: var(--mono); font-size: 0.75rem; border: 1px solid var(--rule); border-bottom-width: 2px; padding: 0 0.3rem; border-radius: 3px; color: var(--ink); }
  @media (hover: none) { .atlas-help .kb { display: none; } }

  .fly { display: flex; align-items: baseline; gap: 0.75rem; margin-top: 1rem; }
  .fly-label { flex: none; }
  .fly ul { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0; padding: 0; }
  .fly a {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.5rem; padding: 0.2rem 0.8rem;
    border: 1px solid var(--rule); border-radius: 2rem; font-size: 0.95rem; background: var(--paper);
  }
  .fly a:hover, .fly a:focus-visible, .fly a[aria-current="true"] { border-color: var(--accent); color: var(--accent); background: var(--paper); }
  .fly a .mono { font-size: 0.72rem; }
  .uncharted { margin: 0.75rem 0 0; }

  .strips { display: none; list-style: none; padding: 0; margin: 1.25rem auto 0; }

  /* Phones and small tablets: the chart becomes a still thumbnail; strips carry navigation. */
  @media (max-width: 47.99rem) {
    .atlas-intro { grid-template-columns: 1fr; }
    .alt-route { grid-column: 1; }
    .atlas-frame :global(.sky-interactive) { pointer-events: none; }
    .atlas-frame :global(.s-label), .atlas-frame :global(.c-count) { display: none; }
    .atlas-frame :global(.cartouche) { display: none; }
    .atlas-bar { padding: 0.5rem 0.7rem; }
    .legend { gap: 0.15rem 0.9rem; font-size: 0.72rem; }
    .card, .atlas-help, .fly, .reset { display: none !important; }
    .strips { display: block; }
    .strip { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; padding: 1.1rem 0; border-top: 1px solid var(--rule); }
    .strip :global(.strip-sky) { border: 1px solid var(--rule); background: var(--paper); aspect-ratio: 1.6; align-self: start; }
    .strip .strip-h { font-family: var(--serif); font-weight: 400; font-size: 1.45rem; margin: 0 0 0.35rem; line-height: 1.1; }
    .strip .strip-h .mono { font-size: 0.72rem; margin-left: 0.25rem; }
    .strip ul { list-style: none; margin: 0; padding: 0; }
    .strip li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 0.75rem; padding: 0.3rem 0; font-size: 0.98rem; }
    .strip li a { padding-block: 0.25rem; }
    .strip .all { display: inline-block; margin-top: 0.3rem; padding-block: 0.4rem; }
  }
</style>
