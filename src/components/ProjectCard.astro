---
import type { Project } from "../lib/content";
import { no } from "../lib/content";
import { categoryLabel } from "../lib/site";
import Status from "./Status.astro";
interface Props { project: Project; level?: 2 | 3; eager?: boolean }
const { project, level = 3, eager = false } = Astro.props;
const d = project.data;
const H = `h${level}`;
---
<article class="card" data-categories={d.categories.join(" ")}>
  {d.image ? (
    <div class:list={["plate", { pixel: d.image.pixel }]}>
      <img src={d.image.src} alt="" width={d.image.width} height={d.image.height} loading={eager ? "eager" : "lazy"} decoding="async" />
    </div>
  ) : (
    <div class="plate blank" aria-hidden="true"><span>{no(d.no)}</span></div>
  )}
  <p class="meta mono">{no(d.no)} · {d.kind} · <Status status={d.status} /></p>
  <H class="title"><a class="stretch" href={`/projects/${project.id}/`}>{d.title}</a></H>
  <p class="summary">{d.summary}</p>
  <p class="cats mono">{d.categories.map(categoryLabel).join(" · ")}</p>
</article>

<style>
  .card { position: relative; padding-top: 1.1rem; border-top: 1px solid var(--edge); display: flex; flex-direction: column; }
  .card::before { content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 0.45s ease; }
  .card:hover::before, .card:focus-within::before { transform: scaleX(1); }
  .card:focus-within { outline: 3px solid var(--accent); outline-offset: 6px; }
  .card { padding-top: 0; border-top: 0; }
  .card::before { top: 0; z-index: 1; }
  .plate { order: -1; margin-bottom: 1rem; border: 1px solid var(--edge); background: var(--paper-deep); aspect-ratio: 16 / 10; overflow: hidden; line-height: 0; transition: border-color 0.25s ease; }
  .plate img { width: 100%; height: 100%; object-fit: cover; }
  .plate.pixel img { image-rendering: pixelated; }
  /* No picture yet: the catalogue number, set like a specimen label */
  .plate.blank { display: grid; place-items: center; line-height: 1; background: var(--paper-deep) linear-gradient(var(--rule), var(--rule)) center 62% / 40% 1px no-repeat; }
  .plate.blank span { font-family: var(--serif); font-weight: 300; font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem); color: var(--muted); letter-spacing: -0.01em; }
  .card:hover .plate { border-color: var(--accent); }
  .meta { margin: 0 0 0.55rem; }
  .title { font-family: var(--serif); font-weight: 400; font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); line-height: 1.1; letter-spacing: -0.012em; margin: 0 0 0.5rem; }
  .stretch { background-image: none; }
  .stretch::after { content: ""; position: absolute; inset: 0; }
  .stretch:focus-visible { outline: none; }
  .card:hover .title a { color: var(--accent); }
  .summary { margin: 0 0 0.75rem; color: var(--muted); max-width: 34rem; text-wrap: pretty; }
  .cats { margin: auto 0 0; }
</style>
