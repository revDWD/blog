---
interface Props { date: string; title: string; status?: string }
const { date, title, status } = Astro.props;
const d = new Date(date);
const label = d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<li class="log-entry">
  <p class="le-meta mono"><time datetime={d.toISOString().slice(0, 10)}>{label}</time>{status && <> · <span>{status}</span></>}</p>
  <p class="le-title">{title}</p>
  <div class="le-body"><slot /></div>
</li>
<style>
  .log-entry { position: relative; padding: 0 0 1.6rem; }
  .log-entry::before { content: ""; position: absolute; left: calc(-1.4rem - 5px); top: 0.45rem; width: 9px; height: 9px; border-radius: 50%; background: var(--paper); border: 1.5px solid var(--edge); }
  .log-entry:last-child::before { background: var(--coral); border-color: var(--coral); }
  .le-meta { margin: 0; }
  .le-title { font-family: var(--serif); font-size: 1.3rem; line-height: 1.25; margin: 0.15rem 0 0.35rem; }
  .le-body :global(p) { margin: 0 0 0.6rem; }
  .le-body :global(p:last-child) { margin-bottom: 0; }
</style>
