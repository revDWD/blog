---
/** <Log> wraps <LogEntry date="2026-11-23" title="…">…</LogEntry>: the progress journal, newest last. */
interface Props { title?: string }
const { title = "Progress journal" } = Astro.props;
---
<section class="d-log" aria-label={title}>
  <p class="mono log-head">{title}</p>
  <ol><slot /></ol>
</section>
<style>
  .d-log { margin-block: 2.5rem; }
  .log-head { margin: 0 0 0.75rem; text-transform: none; }
  ol { list-style: none; margin: 0; padding: 0 0 0 1.4rem; border-left: 1px solid var(--edge); }
</style>
