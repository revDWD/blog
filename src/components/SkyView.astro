---
/**
 * Draws the sky (or a framed part of it). One renderer for:
 *  - the interactive home atlas (interactive: stars are real links with ids and data for the script)
 *  - constellation plates on dossiers and field pages (highlight one star, dim other fields)
 *  - decorative thumbnails (decorative: aria-hidden, no links)
 * Everything is static SVG produced at build time, so it works without JavaScript.
 */
import StarGlyph from "./StarGlyph.astro";
import { W, H, dust, type Atlas } from "../lib/atlas";
import { no, STATUS_LABEL } from "../lib/content";

interface Props {
  atlas: Atlas;
  viewBox?: string;
  interactive?: boolean;
  decorative?: boolean;
  focusField?: string;
  highlight?: string;
  labelAll?: boolean;
  grid?: boolean;
  label?: string;
  describedBy?: string;
  class?: string;
  cartouche?: boolean;
  isolate?: boolean; // draw only focusField (thumbnails)
  slice?: boolean; // fill the box and crop the sides (keeps plates legible on narrow screens)
}
const {
  atlas, viewBox = `0 0 ${W} ${H}`, interactive = false, decorative = false, focusField, highlight,
  labelAll = false, grid = true, label, describedBy, class: cls, cartouche = false, slice = false, isolate = false,
} = Astro.props;

const meridians = Array.from({ length: 11 }, (_, i) => {
  const x = ((i + 1) * W) / 12;
  return `M${x} 0Q${(x + (x - W / 2) * 0.14).toFixed(1)} ${H / 2} ${x} ${H}`;
});
const parallels = Array.from({ length: 5 }, (_, j) => {
  const y = ((j + 1) * H) / 6;
  return `M0 ${y}Q${W / 2} ${(y + (y - H / 2) * 0.16).toFixed(1)} ${W} ${y}`;
});
const ticks: string[] = [];
for (let x = 0; x <= W; x += 20) {
  const len = x % 200 === 0 ? 10 : x % 100 === 0 ? 7 : 4;
  ticks.push(`M${x} 0v${len}M${x} ${H}v${-len}`);
}
for (let y = 0; y <= H; y += 20) {
  const len = y % 200 === 0 ? 10 : y % 100 === 0 ? 7 : 4;
  ticks.push(`M0 ${y}h${len}M${W} ${y}h${-len}`);
}
const motes = dust();
const ecliptic = (() => {
  const pts: string[] = [];
  for (let x = -20; x <= W + 20; x += 40) pts.push(`${x} ${(H * 0.5 + Math.sin((x / W) * Math.PI * 2 + 0.6) * H * 0.2).toFixed(1)}`);
  return "M" + pts.join("L");
})();

// When framing part of the sky, counter-scale type and glyphs so a plate never shouts.
const vbw = +viewBox.split(/\s+/)[2];
const z = W / vbw;
const scaleStyle = z > 1.05 ? `--lz:${(1 / Math.pow(z, 0.8)).toFixed(3)};--gz:${(1 / Math.pow(z, 0.45)).toFixed(3)}` : undefined;
const starsBy = (field: string) => atlas.stars.filter((s) => s.field === field);
const labelFor = (s: Atlas["stars"][number]) =>
  `${no(s.no)}, ${s.title}. ${STATUS_LABEL[s.status]}. ${s.fieldName}, ${s.rank} of ${s.of}.`;
---
<svg
  class:list={["sky", cls, { "sky-interactive": interactive, "has-focus-field": !!focusField }]}
  viewBox={viewBox}
  xmlns="http://www.w3.org/2000/svg"
  role={decorative ? undefined : interactive ? "group" : "img"}
  aria-hidden={decorative ? "true" : undefined}
  aria-label={decorative ? undefined : label}
  aria-describedby={describedBy}
  data-full={`0 0 ${W} ${H}`}
  tabindex={interactive ? "-1" : undefined}
  focusable="false"
  preserveAspectRatio={slice ? "xMidYMid slice" : "xMidYMid meet"}
  style={scaleStyle}
>
  {grid && (
    <g class="layer-grid" aria-hidden="true">
      <rect x="0.5" y="0.5" width={W - 1} height={H - 1} fill="none" stroke="var(--chart-line)" stroke-width="1" />
      <rect x="14" y="14" width={W - 28} height={H - 28} fill="none" stroke="var(--chart-grid)" stroke-width="1" />
      <path d={meridians.join("") + parallels.join("")} fill="none" stroke="var(--chart-grid)" stroke-width="1" />
      <path d={ticks.join("")} stroke="var(--chart-line)" stroke-width="0.8" />
      <path class="ecliptic" d={ecliptic} fill="none" stroke="var(--chart-grid)" stroke-width="1.2" stroke-dasharray="2 7" />
      <g class="motes" fill="var(--chart-dust)">
        {motes.map((m) => <circle cx={m.x} cy={m.y} r={m.r} />)}
      </g>
    </g>
  )}

  {!isolate && <g class="layer-threads" aria-hidden="true" fill="none">
    {atlas.threads.map((t) => (
      <path class="thread" data-a={t.a} data-b={t.b} d={t.d} stroke="var(--accent)" stroke-width="1.1" stroke-dasharray="1 5" stroke-linecap="round" />
    ))}
  </g>}

  {atlas.constellations.filter((c) => !isolate || c.id === focusField).map((c, ci) => {
    const list = starsBy(c.id);
    const dim = focusField && focusField !== c.id;
    return (
      <g class:list={["constellation", { "is-dim": dim, "is-focus": focusField === c.id }]} data-field={c.id} style={`--ci:${ci}`}
         role={interactive ? "group" : undefined} aria-label={interactive ? `${c.name}, ${c.count} ${c.count === 1 ? "star" : "stars"}` : undefined}>
        <g class="figure" aria-hidden="true">
          {c.lines.map(([x1, y1, x2, y2], li) => (
            <line class="fig-line" x1={x1} y1={y1} x2={x2} y2={y2} pathLength="1" style={`--li:${li}`} />
          ))}
          <circle class="region" cx={c.cx} cy={c.cy} r={c.radius + 18} />
        </g>
        {interactive ? (
          <a class="c-label plain" href={`/fields/${c.id}/`} tabindex="-1" aria-label={`${c.name} ${c.count === 1 ? "1 star" : `${c.count} stars`}, constellation page`}>
            <text x={c.cx} y={c.labelY} text-anchor="middle" class="c-name">{c.name}</text>
            <text x={c.cx} y={c.labelY + 17} text-anchor="middle" class="c-count">{c.count === 1 ? "1 star" : `${c.count} stars`}</text>
          </a>
        ) : (
          <g aria-hidden="true">
            <text x={c.cx} y={c.labelY} text-anchor="middle" class="c-name">{c.name}</text>
          </g>
        )}
        {list.map((s, si) => {
          const lab = labelAll || s.labelled || s.id === highlight;
          const inner = (
            <g transform={`translate(${s.x} ${s.y})`}>
              <g class="g-scale">
                {s.id === highlight && <circle class="hl-ring" r={s.r + 11} fill="none" stroke="var(--coral)" stroke-width="1.4" />}
                <circle class="hit" r={Math.max(s.r + 9, 18)} fill="transparent" />
                <StarGlyph glyph={s.glyph} r={s.r} rays={s.r >= 10} pulse={interactive && s.pulse} />
              </g>
              <text class:list={["s-label", { "is-shown": lab }]} x={s.label.x} y={s.label.y} text-anchor={s.label.anchor}>
                <tspan class="s-no">{String(s.no).padStart(2, "0")}</tspan> {s.title}
              </text>
            </g>
          );
          return interactive ? (
            <a class="star plain" id={`no-${String(s.no).padStart(2, "0")}`} href={s.href} aria-label={labelFor(s)}
               data-id={s.id} data-field={s.field} data-no={s.no} data-x={s.x} data-y={s.y} data-glyph={s.glyph}
               data-title={s.title} data-dek={s.dek} data-status={STATUS_LABEL[s.status]} data-field-name={s.fieldName}
               data-updated={s.updated} data-related={s.related.join(" ")} style={`--si:${si}`}>
              {inner}
            </a>
          ) : (
            <g class:list={["star", { "is-hl": s.id === highlight }]} data-id={s.id}>{inner}</g>
          );
        })}
      </g>
    );
  })}

  {cartouche && (
    <g class="cartouche" aria-hidden="true" transform={`translate(38 ${H - 128})`}>
      <rect width="300" height="92" fill="var(--paper)" stroke="var(--chart-line)" />
      <rect x="5" y="5" width="290" height="82" fill="none" stroke="var(--chart-grid)" />
      <text x="20" y="38" class="ct-title">Atlas of the Workshop</text>
      <text x="20" y="60" class="ct-sub">Abby + David · St. Louis</text>
      <text x="20" y="77" class="ct-sub">Epoch {atlas.epoch} · {atlas.stars.length} stars charted</text>
    </g>
  )}
</svg>

<style is:global>
  .sky { display: block; width: 100%; height: auto; color: var(--chart-ink); overflow: hidden; }
  .sky text { font-family: var(--serif); fill: var(--chart-ink); }
  .sky .c-name { font-style: italic; font-size: calc(26px * var(--lz, 1)); letter-spacing: 0.01em; paint-order: stroke; stroke: var(--paper); stroke-width: 6px; stroke-linejoin: round; }
  .sky .c-count { font-family: var(--mono); font-size: calc(11px * var(--lz, 1)); fill: var(--muted); letter-spacing: 0.04em; paint-order: stroke; stroke: var(--paper); stroke-width: 4px; }
  .sky .fig-line { stroke: var(--chart-line); stroke-width: calc(1px * var(--lz, 1)); stroke-dasharray: 1; stroke-dashoffset: 0; }
  .sky .region { fill: none; stroke: none; }
  .sky .s-label { font-size: calc(17.5px * var(--lz, 1)); opacity: 0; transition: opacity 0.25s ease; paint-order: stroke; stroke: var(--paper); stroke-width: 5px; stroke-linejoin: round; pointer-events: none; }
  .sky .s-label.is-shown { opacity: 1; }
  /* a visible title is part of the link: clicking the name opens the dossier too */
  .sky-interactive .s-label.is-shown, .sky-interactive .is-hot .s-label, .sky-interactive .is-kin .s-label, .sky-interactive .is-zoomed .s-label { pointer-events: auto; cursor: pointer; }
  .sky .s-no { font-family: var(--mono); font-size: 0.72em; fill: var(--muted); }
  .sky .g-scale { transform: scale(var(--gz, 1)); transition: transform 0.6s var(--ease-out); }
  .sky .glyph-bench { color: var(--coral); }
  .sky .is-dim { opacity: 0.28; }
  .sky .is-dim .s-label { display: none; }
  .sky.strip-sky .s-label { display: none; }
  .sky .is-hl .s-label { opacity: 1; font-weight: 500; }
  .sky .thread { opacity: 0; transition: opacity 0.3s ease; }
  .sky .ct-title { font-style: italic; font-size: 24px; }
  .sky .ct-sub { font-family: var(--mono); font-size: 11.5px; fill: var(--muted); }
  :root[data-theme="dark"] .sky .glyph-complete, :root[data-theme="dark"] .sky .glyph-evolving { filter: drop-shadow(0 0 4px var(--chart-glow)); }

  .sky .pulse { transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .sky .pulse { animation: star-pulse 2.8s cubic-bezier(0.2, 0.6, 0.3, 1) 6 both; } /* six breaths, then still (WCAG 2.2.2) */
    html.js:not([data-drawn]) .sky-interactive .fig-line { animation: fig-draw 1.4s var(--ease-out) both; animation-delay: calc(var(--ci) * 110ms + var(--li) * 60ms + 200ms); }
    html.js:not([data-drawn]) .sky-interactive .star { animation: star-appear 0.7s var(--ease-out) both; animation-delay: calc(var(--ci) * 110ms + var(--si) * 45ms); }
    html.js:not([data-drawn]) .sky-interactive .c-label { animation: star-appear 0.9s ease both; animation-delay: calc(var(--ci) * 110ms + 300ms); }
  }
  @keyframes star-pulse { 0% { transform: scale(1); opacity: 0.9; } 100% { transform: scale(2.6); opacity: 0; } }
  @keyframes fig-draw { from { stroke-dashoffset: 1; } }
  @keyframes star-appear { from { opacity: 0; } }
</style>
