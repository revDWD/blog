---
/** The status instrument: where a piece of work sits on its way from idea to done. */
import { STATUS_LABEL } from "../lib/content";
interface Props { status: string; pausedAt?: string }
const { status, pausedAt } = Astro.props;
const stages = ["idea", "researching", "exploring", "building", "completed"] as const;
const map: Record<string, string> = { "in-progress": "building", evolving: "completed", paused: pausedAt ?? "building" };
const at = map[status] ?? status;
const idx = stages.indexOf(at as (typeof stages)[number]);
const paused = status === "paused";
const evolving = status === "evolving";
---
<div class:list={["track", { paused }]} role="img" aria-label={`Status: ${STATUS_LABEL[status]}${paused ? `, stopped at ${STATUS_LABEL[at].toLowerCase()}` : ""}. Stage ${idx + 1} of ${stages.length}.`}>
  <ol aria-hidden="true">
    {stages.map((s, i) => (
      <li class:list={{ done: i < idx, here: i === idx }}>
        <span class="dot"></span>
        <span class="lbl mono">{i === idx && paused ? "Paused" : i === idx && evolving ? "Live · evolving" : i === idx && status === "in-progress" ? "In progress" : STATUS_LABEL[s]}</span>
      </li>
    ))}
  </ol>
</div>
<style>
  .track ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); position: relative; }
  .track ol::before { content: ""; position: absolute; left: 0.45rem; right: 0.45rem; top: 0.45rem; height: 1px; background: var(--rule); }
  .track li { position: relative; display: flex; flex-direction: column; gap: 0.45rem; }
  .dot { width: 0.9rem; height: 0.9rem; border-radius: 50%; border: 1.5px solid var(--rule); background: var(--paper); position: relative; z-index: 1; }
  .done .dot { background: var(--edge); border-color: var(--edge); }
  .done::after { content: ""; position: absolute; left: 0.45rem; right: -0.45rem; top: 0.45rem; height: 1.5px; background: var(--edge); }
  .here .dot { background: var(--coral); border-color: var(--coral); box-shadow: 0 0 0 4px var(--paper), 0 0 0 5px var(--coral); }
  .paused .here .dot { background: linear-gradient(90deg, var(--edge) 50%, var(--paper) 50%); border-color: var(--edge); box-shadow: 0 0 0 4px var(--paper), 0 0 0 5px var(--edge); }
  .lbl { font-size: 0.72rem; color: var(--muted); }
  .here .lbl { color: var(--ink); }
  @media (max-width: 34rem) { .lbl { display: none; } .here .lbl { display: block; position: absolute; top: 1.5rem; white-space: nowrap; } .track { padding-bottom: 1.4rem; } }
</style>
