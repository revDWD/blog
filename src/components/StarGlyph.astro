---
/**
 * One star, drawn at (0,0). Six shapes, one per status family, so status never relies on colour.
 *   idea      dashed ring          survey    ring + core + ticks (researching / exploring)
 *   bench     coral disc + ring    paused    half-filled disc
 *   complete  solid disc + halo    evolving  disc + tilted orbit
 * Colours come from currentColor and --paper, so the same glyph works on the chart, in lists and in pills.
 */
import type { Glyph } from "../lib/atlas";
interface Props { glyph: Glyph; r?: number; rays?: boolean; pulse?: boolean }
const { glyph, r = 6, rays = false, pulse = false } = Astro.props;
const t = (a: number, r1: number, r2: number) => {
  const c = Math.cos(a), s = Math.sin(a);
  return `M${(c * r1).toFixed(2)} ${(s * r1).toFixed(2)}L${(c * r2).toFixed(2)} ${(s * r2).toFixed(2)}`;
};
const sw = Math.max(1, r * 0.16);
---
<g class={`glyph glyph-${glyph}`}>
  {rays && (
    <path class="rays" d={[0.785, 2.356, 3.927, 5.498].map((a) => t(a, r + 3, r + 7 + r * 0.25)).join("")} stroke="currentColor" stroke-width="0.8" stroke-linecap="round" opacity="0.55" />
  )}
  {glyph === "idea" && (
    <circle r={r} fill="var(--paper)" stroke="currentColor" stroke-width={sw} stroke-dasharray={`${(r * 0.55).toFixed(2)} ${(r * 0.45).toFixed(2)}`} />
  )}
  {glyph === "survey" && (
    <>
      <circle r={r} fill="var(--paper)" stroke="currentColor" stroke-width={sw} />
      <circle r={r * 0.32} fill="currentColor" />
      <path d={[0, 1.571, 3.142, 4.712].map((a) => t(a, r + 1.6, r + 4.2)).join("")} stroke="currentColor" stroke-width={sw * 0.8} stroke-linecap="round" />
    </>
  )}
  {glyph === "bench" && (
    <>
      {pulse && <circle class="pulse" r={r + 2} fill="none" stroke="var(--coral)" stroke-width="1.2" />}
      <circle r={r + 3.2} fill="none" stroke="var(--coral)" stroke-width="1" opacity="0.7" />
      <circle r={r} fill="var(--coral)" />
    </>
  )}
  {glyph === "paused" && (
    <>
      <circle r={r} fill="var(--paper)" stroke="currentColor" stroke-width={sw} />
      <path d={`M0 ${-r}A${r} ${r} 0 0 0 0 ${r}Z`} fill="currentColor" opacity="0.75" />
    </>
  )}
  {glyph === "complete" && (
    <>
      <circle r={r + 2.6} fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.4" />
      <circle r={r} fill="currentColor" />
    </>
  )}
  {glyph === "evolving" && (
    <>
      <ellipse rx={r + 5} ry={(r + 5) * 0.42} fill="none" stroke="currentColor" stroke-width="0.9" transform="rotate(-28)" opacity="0.8" />
      <circle r={r * 0.82} fill="currentColor" />
    </>
  )}
</g>
