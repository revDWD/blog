---
interface Props { current?: string }
const { current } = Astro.props;
const nav = [
  { id: "atlas", label: "Atlas", href: "/" },
  { id: "ledger", label: "Ledger", href: "/ledger/" },
  { id: "bench", label: "Bench", href: "/bench/" },
  { id: "notes", label: "Notes", href: "/notes/" },
];
---
<header class="site-header">
  <div class="wrap-wide">
    <p class="brand">
      <a class="wordmark" href="https://abbydavid.com/" aria-label="Abby + David, main site">Abby<span>+</span>David</a>
      <span class="slash" aria-hidden="true">/</span>
      <a class="room" href="/" aria-label="Workshop, home">Workshop</a>
    </p>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={current === n.id ? "page" : undefined}>{n.label}</a></li>
        ))}
        <li>
          <button class="theme-toggle" type="button" role="switch" aria-checked="false" hidden>
            <span class="label">Dark mode</span><span class="state" aria-hidden="true">Off</span><span class="track" aria-hidden="true"></span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { padding: 1.25rem 0 0; position: relative; z-index: 5; }
  .site-header .wrap-wide { display: flex; justify-content: space-between; align-items: center; gap: 0.25rem 1rem; flex-wrap: wrap; }
  .brand { margin: 0; display: flex; align-items: center; gap: 0.15rem; }
  .wordmark, .room {
    display: inline-flex; align-items: center; min-height: 2.75rem; background-image: none;
    font-family: var(--serif); font-size: 1.35rem; font-weight: 500; letter-spacing: -0.005em;
  }
  .wordmark span { color: var(--coral); font-style: italic; font-weight: 400; margin-inline: 0.18em; }
  .wordmark:hover, .wordmark:focus-visible { color: var(--ink); }
  .slash { font-family: var(--serif); font-size: 1.35rem; color: var(--rule); margin-inline: 0.35rem 0.25rem; font-weight: 300; }
  .room { font-style: italic; font-weight: 400; color: var(--muted); }
  .room:hover { color: var(--accent); }

  .site-nav { margin-left: auto; margin-right: -0.5rem; }
  .site-nav ul { display: flex; flex-wrap: wrap; align-items: center; gap: 0 clamp(0.1rem, 1.2vw, 0.6rem); list-style: none; margin: 0; padding: 0; }
  .site-nav li > a {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding-inline: 0.5rem;
    font-size: 1rem; color: var(--muted); background-image: none; position: relative; white-space: nowrap;
  }
  .site-nav li > a::after {
    content: ""; position: absolute; left: 0.5rem; right: 0.5rem; bottom: 0.55rem; height: 1px;
    background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 0.3s ease;
  }
  .site-nav li > a:hover, .site-nav li > a:focus-visible { color: var(--ink); }
  .site-nav li > a:hover::after, .site-nav li > a:focus-visible::after { transform: scaleX(1); }
  .site-nav a[aria-current="page"] { color: var(--ink); }
  .site-nav a[aria-current="page"]::after { transform: scaleX(1); background: var(--coral); height: 2px; }

  .theme-toggle {
    display: inline-flex; align-items: center; gap: 0.55rem; min-height: 2.75rem; min-width: 2.75rem;
    padding: 0 0.5rem; margin-left: 0.25rem; font: inherit; font-size: 0.95rem; color: var(--ink);
    background: none; border: 0; cursor: pointer; touch-action: manipulation; white-space: nowrap;
  }
  .theme-toggle .track { position: relative; flex: none; width: 2.5rem; height: 1.4rem; border: 1.5px solid var(--edge); border-radius: 1rem; background: var(--paper-deep); transition: background-color 0.25s ease; }
  .theme-toggle .track::after { content: ""; position: absolute; top: 2px; left: 2px; width: calc(1.4rem - 7px); height: calc(1.4rem - 7px); border-radius: 50%; background: #a97a10; transition: transform 0.25s ease, background-color 0.25s ease; }
  .theme-toggle[aria-checked="true"] .track { background: var(--accent-soft); }
  .theme-toggle[aria-checked="true"] .track::after { transform: translateX(1.1rem); background: var(--ink); }
  .theme-toggle .state { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); min-width: 1.6em; }
  .theme-toggle:hover .label { color: var(--accent); }

  @media (max-width: 40rem) {
    .site-header .wrap-wide { flex-direction: column; align-items: flex-start; gap: 0; }
    .site-nav { margin: 0 0 0 -0.5rem; }
    .site-nav li > a { padding-inline: 0.45rem; font-size: 0.95rem; }
    .theme-toggle .state { display: none; }
    .theme-toggle .label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .theme-toggle::before { content: "Dark"; content: "Dark" / ""; font-size: 0.95rem; color: var(--muted); } /* shown, not announced */
    .theme-toggle { gap: 0.35rem; margin-left: 0; }
    .theme-toggle .track { width: 2.2rem; }
    .theme-toggle[aria-checked="true"] .track::after { transform: translateX(0.8rem); }
  }
</style>
