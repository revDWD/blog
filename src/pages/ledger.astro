---
import Base from "../layouts/Base.astro";
import LedgerList from "../components/LedgerList.astro";
import { getEntries, getFields, getAtlas, STATUS_LABEL, KIND_LABEL } from "../lib/content";

const entries = await getEntries();
const fields = await getFields();
const atlas = await getAtlas();
const fieldNames = Object.fromEntries(fields.map((f) => [f.id, f.data.name]));
const statuses = [...new Set(entries.map((e) => e.data.status))];
const kinds = [...new Set(entries.map((e) => e.data.kind))];
---
<Base title="The Ledger" description="Every entry in the Abby + David workshop, as a catalogue: projects, experiments, research and trips." current="ledger">
  <header class="page-head wrap">
    <p class="eyebrow mono">The Ledger · {entries.length} entries · newest catalogue number first</p>
    <h1>The Ledger</h1>
    <p class="lede">The atlas as a list. Every star, with its number, field and status.</p>
  </header>
  <div class="wrap">
    <form class="filters" data-filters aria-label="Filter the ledger" hidden>
      <label>Field
        <select name="field"><option value="">All fields</option>{atlas.constellations.map((c) => <option value={c.id}>{c.name} ({c.count})</option>)}</select>
      </label>
      <label>Status
        <select name="status"><option value="">Any status</option>{statuses.map((s) => <option value={s}>{STATUS_LABEL[s]}</option>)}</select>
      </label>
      <label>Kind
        <select name="kind"><option value="">Any kind</option>{kinds.map((k) => <option value={k}>{KIND_LABEL[k]}</option>)}</select>
      </label>
      <p class="mono count" aria-live="polite" data-count>{entries.length} shown</p>
    </form>
    <LedgerList entries={entries} fieldNames={fieldNames} level={2} />
    <p class="mono empty" data-empty hidden>Nothing matches those filters yet.</p>
  </div>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>("[data-filters]");
  if (form) {
    form.hidden = false;
    const rows = [...document.querySelectorAll<HTMLElement>(".ledger .row")];
    const count = form.querySelector("[data-count]")!;
    const empty = document.querySelector<HTMLElement>("[data-empty]")!;
    const params = new URLSearchParams(location.search);
    for (const k of ["field", "status", "kind"]) { const v = params.get(k); if (v) (form.elements.namedItem(k) as HTMLSelectElement).value = v; }
    const apply = () => {
      const f = new FormData(form);
      const field = f.get("field") as string, status = f.get("status") as string, kind = f.get("kind") as string;
      let n = 0;
      for (const r of rows) {
        const ok = (!field || r.dataset.field === field || (r.dataset.also ?? "").split(" ").includes(field)) &&
          (!status || r.dataset.status === status) && (!kind || r.dataset.kind === kind);
        r.hidden = !ok;
        if (ok) n++;
      }
      count.textContent = `${n} shown`;
      empty.hidden = n > 0;
      const q = new URLSearchParams();
      if (field) q.set("field", field); if (status) q.set("status", status); if (kind) q.set("kind", kind);
      history.replaceState(null, "", q.size ? `?${q}` : location.pathname);
    };
    form.addEventListener("change", apply);
    apply();
  }
</script>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; align-items: end; padding: 1rem 0 1.25rem; border-top: 1px solid var(--edge); border-bottom: 1px solid var(--rule); }
  .filters[hidden] { display: none; }
  .filters label { display: grid; gap: 0.3rem; font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }
  .filters select { font: inherit; font-family: var(--sans); font-size: 1rem; color: var(--ink); background: var(--surface); border: 1px solid var(--edge); min-height: 2.75rem; padding: 0.3rem 2rem 0.3rem 0.7rem; border-radius: 2px; }
  .count { margin: 0 0 0.7rem auto; }
  .empty { padding: 2rem 0; }
</style>
