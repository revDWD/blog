---
import Base from "../layouts/Base.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import Status from "../components/Status.astro";
import { getProjects, no } from "../lib/content";
import { ACTIVE } from "../lib/site";

const projects = await getProjects();
const bench = projects.filter((p) => ACTIVE.has(p.data.status));
const featured = projects.filter((p) => p.data.featured);
const shown = (featured.length >= 2 ? featured : projects).slice(0, 4);
---
<Base title="Workshop" description="The Abby + David workshop: write-ups of the things we make, what each one is, and where it stands." current="home">
  <div class="wrap">
    <header class="page-head">
      <h1>The workshop</h1>
      <p class="lede">Write-ups of the things we make: what each one is, how it works, and where it stands.</p>
    </header>

    {bench.length > 0 && (
      <section class="section" aria-labelledby="bench-title">
        <div class="section-head"><h2 id="bench-title">On the bench</h2></div>
        <ul class="bench">
          {bench.map((p) => (
            <li>
              <p class="mono">{no(p.data.no)} · <Status status={p.data.status} /></p>
              <p class="b-title"><a href={`/projects/${p.id}/`}>{p.data.title}</a></p>
              <p class="b-sum">{p.data.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="section" aria-labelledby="projects-title">
      <div class="section-head">
        <h2 id="projects-title">{featured.length >= 2 ? "Selected projects" : "Projects"}</h2>
        <a class="more" href="/projects/">All {projects.length} projects →</a>
      </div>
      <ProjectGrid projects={shown} />
    </section>

  </div>
</Base>

<style>
  .section-head { margin-bottom: 1.5rem; }
  .bench { list-style: none; margin: 0; padding: 0; }
  .bench li { padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  .bench li:first-child { padding-top: 0.25rem; }
  .bench p { margin: 0; }
  .b-title { font-family: var(--serif); font-size: 1.45rem; line-height: 1.2; margin: 0.2rem 0 0.25rem !important; }
  .b-sum { color: var(--muted); max-width: 40rem; }
</style>
