---
import Base from "../../layouts/Base.astro";
import LedgerList from "../../components/LedgerList.astro";
import { getEntries, getFields, slugify } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getEntries();
  const tags = new Map<string, string>();
  for (const e of entries) for (const t of e.data.tags) tags.set(slugify(t), t);
  return [...tags].map(([slug, label]) => ({ params: { tag: slug }, props: { label } }));
}
const { label } = Astro.props;
const { tag } = Astro.params;
const entries = (await getEntries()).filter((e) => e.data.tags.some((t) => slugify(t) === tag));
const fieldNames = Object.fromEntries((await getFields()).map((f) => [f.id, f.data.name]));
---
<Base title={`#${label}`} description={`Entries tagged ${label} in the Abby + David workshop.`} noindex={entries.length < 2}>
  <header class="page-head wrap">
    <p class="eyebrow mono"><a href="/ledger/">← Ledger</a> · Tag</p>
    <h1>#{label}</h1>
    <p class="lede">{entries.length} {entries.length === 1 ? "entry" : "entries"}.</p>
  </header>
  <div class="wrap"><LedgerList entries={entries} fieldNames={fieldNames} level={2} /></div>
</Base>
