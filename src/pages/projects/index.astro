---
import Base from "../../layouts/Base.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import { getProjects } from "../../lib/content";
import { CATEGORIES } from "../../lib/site";

const projects = await getProjects();
const used = CATEGORIES.map((c) => ({ ...c, count: projects.filter((p) => p.data.categories.includes(c.id)).length })).filter((c) => c.count > 0);
---
<Base title="Projects" description="Every project in the Abby + David workshop, newest first." current="projects">
  <div class="wrap">
    <header class="page-head">
      <h1>Projects</h1>
      <p class="lede">Everything we've made so far, newest first.</p>
    </header>

    <div class="filter" data-filter hidden>
      <p class="mono" id="filter-label">Show</p>
      <ul aria-labelledby="filter-label">
        <li><button type="button" data-cat="" aria-pressed="true">All <span class="mono">{projects.length}</span></button></li>
        {used.map((c) => (
          <li><button type="button" data-cat={c.id} aria-pressed="false">{c.label} <span class="mono">{c.count}</span></button></li>
        ))}
      </ul>
      <p class="mono count" aria-live="polite" data-count></p>
    </div>

    <ProjectGrid projects={projects} level={2} />
  </div>
</Base>

<script>
  const box = document.querySelector<HTMLElement>("[data-filter]");
  if (box) {
    box.hidden = false;
    const buttons = [...box.querySelectorAll<HTMLButtonElement>("button[data-cat]")];
    const cards = [...document.querySelectorAll<HTMLElement>("[data-grid] .card")];
    const count = box.querySelector<HTMLElement>("[data-count]")!;
    const show = (cat: string, announce = true) => {
      let n = 0;
      for (const c of cards) {
        const ok = !cat || (c.dataset.categories ?? "").split(" ").includes(cat);
        c.hidden = !ok;
        if (ok) n++;
      }
      for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.cat === cat));
      if (announce) count.textContent = `${n} ${n === 1 ? "project" : "projects"}`;
      try { history.replaceState(null, "", cat ? `#${cat}` : location.pathname); } catch { /* ignore */ }
    };
    for (const b of buttons) b.addEventListener("click", () => show(b.dataset.cat ?? ""));
    const start = location.hash.slice(1);
    show(buttons.some((b) => b.dataset.cat === start) ? start : "", false);
  }
</script>

<style>
  .filter { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; margin: 0 0 2.5rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--rule); }
  .filter[hidden] { display: none; }
  .filter p { margin: 0; }
  .filter ul { display: flex; flex-wrap: wrap; gap: 0 0.25rem; list-style: none; margin: 0; padding: 0; }
  .filter button {
    position: relative; font: inherit; font-size: 1rem; color: var(--muted); background: none; border: 0; cursor: pointer;
    min-height: 2.75rem; padding: 0 0.5rem;
  }
  .filter button .mono { font-size: 0.72rem; margin-left: 0.15rem; }
  .filter button::after { content: ""; position: absolute; left: 0.5rem; right: 0.5rem; bottom: 0.55rem; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 0.3s ease; }
  .filter button:hover, .filter button:focus-visible { color: var(--ink); }
  .filter button:hover::after { transform: scaleX(1); }
  .filter button[aria-pressed="true"] { color: var(--ink); }
  .filter button[aria-pressed="true"]::after { transform: scaleX(1); background: var(--coral); height: 2px; }
  .count { margin-left: auto !important; }
  :global(.card[hidden]) { display: none; }
</style>
