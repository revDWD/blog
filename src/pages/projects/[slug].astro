---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import Status from "../../components/Status.astro";
import * as mdx from "../../components/mdx";
import { getProjects, no, monthYear, fullDate, iso } from "../../lib/content";
import { categoryLabel } from "../../lib/site";

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);

// Two more projects: same category first, then the newest others.
const others = (await getProjects()).filter((p) => p.id !== project.id);
const share = (p: (typeof others)[number]) => p.data.categories.filter((c) => d.categories.includes(c)).length;
const more = [...others].sort((a, b) => share(b) - share(a) || b.data.no - a.data.no).slice(0, 2);

const jsonld = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: d.title,
  description: d.summary,
  url: new URL(`/projects/${project.id}/`, Astro.site).href,
  dateCreated: d.started.toISOString(),
  ...(d.updated && { dateModified: d.updated.toISOString() }),
  creativeWorkStatus: d.status,
  keywords: [...d.categories.map(categoryLabel), ...d.stack].join(", "),
  author: [{ "@type": "Person", name: "Abby" }, { "@type": "Person", name: "David" }],
  isPartOf: { "@type": "WebSite", name: "Abby + David Workshop", url: "https://blog.abbydavid.com/" },
  ...(d.links[0] && { sameAs: d.links[0].href }),
};
---
<Base title={d.title} description={d.summary} image={d.image?.src} imageAlt={d.image?.alt} type="article" jsonld={jsonld} published={d.started} modified={d.updated} current="projects">
  <article class="wrap project">
    <header class="page-head">
      <p class="crumbs mono"><a href="/projects/">← All projects</a></p>
      <p class="mono">{no(d.no)} · {d.kind} · Started <time datetime={iso(d.started)}>{monthYear(d.started)}</time></p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
    </header>

    <dl class="facts">
      <div><dt>Status</dt><dd><Status status={d.status} /></dd></div>
      <div><dt>Categories</dt><dd>{d.categories.map(categoryLabel).join(", ")}</dd></div>
      {d.stack.length > 0 && <div><dt>Built with</dt><dd>{d.stack.join(", ")}</dd></div>}
      {d.updated && <div><dt>Last updated</dt><dd><time datetime={iso(d.updated)}>{fullDate(d.updated)}</time></dd></div>}
    </dl>

    {d.links.length > 0 && (
      <p class="links">
        {d.links.map((l) => <a class="go plain" href={l.href} rel="noopener">{l.label} <b aria-hidden="true">↗</b></a>)}
      </p>
    )}

    {d.image && (
      <figure class:list={["fig", "hero", { pixel: d.image.pixel }]}>
        <div class="plate"><img src={d.image.src} alt={d.image.alt} width={d.image.width} height={d.image.height} fetchpriority="high" decoding="async" /></div>
        <figcaption><span class="num">Fig. 1</span><span>{d.title}.</span></figcaption>
      </figure>
    )}

    <div class="prose">
      <Content components={mdx} />
    </div>
  </article>

  {more.length > 0 && (
    <section class="wrap section" aria-labelledby="more-title">
      <div class="section-head">
        <h2 id="more-title">More projects</h2>
        <a class="more" href="/projects/">All projects →</a>
      </div>
      <ProjectGrid projects={more} />
    </section>
  )}
</Base>

<style>
  .crumbs { margin: 0 0 1.5rem !important; }
  .crumbs a { display: inline-block; padding-block: 0.4rem; }
  .page-head .mono { margin: 0 0 0.9rem; }
  .facts { display: flex; flex-wrap: wrap; gap: 0.75rem 2.5rem; margin: 0; padding: 1rem 0; border-top: 1px solid var(--edge); border-bottom: 1px solid var(--rule); }
  .facts dt { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }
  .facts dd { margin: 0.15rem 0 0; }
  .links { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; margin: 1.25rem 0 0; }
  .go { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; font-family: var(--mono); font-size: 0.9rem; color: var(--accent); }
  .go b { font-weight: 400; transition: transform 0.25s ease; }
  .go:hover b, .go:focus-visible b { transform: translate(2px, -2px); }
  .go:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .hero { margin: 2.25rem 0 0; }
  .hero img { max-height: 70vh; width: 100%; object-fit: contain; }

  .prose { max-width: 40rem; margin-top: 2.5rem; counter-reset: fig 1; }
  .prose :global(> p), .prose :global(> ul), .prose :global(> ol) { font-size: clamp(1.08rem, 1rem + 0.25vw, 1.2rem); line-height: 1.7; }
  .prose :global(h2) { font-family: var(--serif); font-weight: 400; font-size: clamp(1.6rem, 1.35rem + 1vw, 2.1rem); line-height: 1.15; margin: 2.75rem 0 0.75rem; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-family: var(--serif); font-weight: 500; font-size: 1.3rem; margin: 2rem 0 0.5rem; }
  .prose :global(li) { margin-bottom: 0.35rem; }
  .prose :global(code:not(pre code)) { font-family: var(--mono); font-size: 0.86em; background: var(--paper-deep); padding: 0.08em 0.35em; border-radius: 3px; }
  .prose :global(pre) { font-family: var(--mono); font-size: 0.86rem; line-height: 1.6; padding: 1.1rem 1.25rem; border: 1px solid var(--rule); overflow-x: auto; margin: 2rem 0; }
  .prose :global(.d-fig) { margin: 2.25rem 0; counter-increment: fig; }
  .prose :global([data-fig-num])::before { content: "Fig. " counter(fig); }
  .prose :global(blockquote) { margin: 2rem 0; padding-left: 1.2rem; border-left: 2px solid var(--coral); font-family: var(--serif); font-style: italic; font-size: 1.3rem; }
</style>
