---
import { render, getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SkyView from "../../components/SkyView.astro";
import StatusTrack from "../../components/StatusTrack.astro";
import StatusPill from "../../components/StatusPill.astro";
import StarGlyph from "../../components/StarGlyph.astro";
import * as mdx from "../../components/mdx";
import { frame } from "../../lib/atlas";
import {
  getEntries, getFields, getLogs, getAtlas, no, monthYear, fullDate, shortDate, iso, tended,
  KIND_LABEL, STAGED_KINDS, STATUS_LABEL, joinNames, slugify, ids,
} from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);

const atlas = await getAtlas();
const fields = await getFields();
const fieldName = (id: string) => fields.find((f) => f.id === id)?.data.name ?? id;
const authors = new Map((await getCollection("authors")).map((a) => [a.id, a.data.name]));
const authorIds = ids(d.authors);
const byline = joinNames(authorIds.map((a) => authors.get(a) ?? a));
const constellation = atlas.constellations.find((c) => c.id === d.field.id)!;
const star = atlas.stars.find((s) => s.id === entry.id)!;

const all = await getEntries();
const relatedIds = new Set([
  ...d.related.map((r) => r.id),
  ...all.filter((e) => e.data.related.some((r) => r.id === entry.id)).map((e) => e.id),
]);
let threads = all.filter((e) => relatedIds.has(e.id));
const kin = all.filter((e) => e.id !== entry.id && e.data.field.id === d.field.id && !relatedIds.has(e.id));
threads = [...threads, ...kin].slice(0, 4);
const logs = (await getLogs()).filter((l) => l.data.entry.id === entry.id);
const toc = headings.filter((h) => h.depth === 2);
const staged = STAGED_KINDS.has(d.kind);
const updated = tended(entry);

const jsonld = {
  "@context": "https://schema.org",
  "@type": d.kind === "essay" ? "BlogPosting" : "CreativeWork",
  headline: d.title,
  name: d.title,
  description: d.seoDescription ?? d.dek,
  url: new URL(`/projects/${entry.id}/`, Astro.site).href,
  image: new URL(`/og/${entry.id}.png`, Astro.site).href,
  dateCreated: d.started.toISOString(),
  datePublished: d.started.toISOString(),
  dateModified: updated.toISOString(),
  author: authorIds.map((a) => ({ "@type": "Person", name: authors.get(a) ?? a })),
  keywords: d.tags.join(", "),
  genre: KIND_LABEL[d.kind],
  creativeWorkStatus: STATUS_LABEL[d.status],
  isPartOf: { "@type": "WebSite", name: "Abby + David Workshop", url: "https://blog.abbydavid.com/" },
};
---
<Base
  title={d.seoTitle ?? d.title}
  description={d.seoDescription ?? d.dek}
  image={`/og/${entry.id}.png`}
  imageAlt={`${d.title}: ${no(d.no)} in the ${fieldName(d.field.id)} constellation of the Abby + David workshop atlas.`}
  type="article"
  jsonld={jsonld}
  published={d.started}
  modified={updated}
  noindex={d.sample}
>
  <article class="dossier" data-kind={d.kind}>
    <header class="d-head wrap-wide">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        <a href={`/#no-${String(d.no).padStart(2, "0")}`}>← Atlas</a>
        <span aria-hidden="true">/</span>
        <a href={`/fields/${d.field.id}/`}>{fieldName(d.field.id)}</a>
      </nav>

      <div class="d-title-row">
        <div class="d-glyph" aria-hidden="true">
          <svg viewBox="-24 -24 48 48"><StarGlyph glyph={star.glyph} r={10} rays={star.r >= 10} /></svg>
        </div>
        <div>
          <p class="catalogue mono">
            <span>{no(d.no)}</span> · <span>{fieldName(d.field.id)}</span> · <span>{KIND_LABEL[d.kind]}</span> ·
            <span>Started <time datetime={iso(d.started)}>{monthYear(d.started)}</time></span>
            {!staged && <> · <StatusPill status={d.status} /></>}
            {d.sample && <span class="sample-stamp">Sample entry · replace me</span>}
          </p>
          <h1 class="d-title">{d.title}</h1>
          <p class="d-dek">{d.dek}</p>
          <p class="byline mono">
            By {byline} · Last tended <time datetime={iso(updated)} data-relative>{fullDate(updated)}</time>
            {logs[0] && <> · Latest log: <a href={`/logs/${logs[0].id}/`}>{logs[0].data.title}</a></>}
          </p>
          {d.links.length > 0 && (
            <p class="d-links">
              {d.links.map((l) => <a class="go-btn plain" href={l.href} rel="noopener">{l.label} <b aria-hidden="true">↗</b></a>)}
            </p>
          )}
        </div>
      </div>

      {staged && <div class="d-track"><StatusTrack status={d.status} pausedAt={d.pausedAt} /></div>}
    </header>

    <figure class:list={["fig", "d-hero", "wrap-wide", { pixel: d.hero?.pixel }]}>
      <div class="plate">
        {d.hero ? (
          <img src={d.hero.src} alt={d.hero.alt} width={d.hero.width} height={d.hero.height} fetchpriority="high" decoding="async" />
        ) : (
          <SkyView atlas={atlas} viewBox={frame(constellation, 1.6, 2.4)} highlight={entry.id} focusField={d.field.id} labelAll slice
            label={`${d.title} on the atlas: ${no(d.no)} in the ${fieldName(d.field.id)} constellation, with its neighbours.`} class="hero-sky" />
        )}
      </div>
      <figcaption>
        <span class="num">Fig. 1</span>
        <span>{d.hero?.caption ?? `${no(d.no)} in its place in the ${fieldName(d.field.id)} constellation.`} <a href={`/#no-${String(d.no).padStart(2, "0")}`}>Find it on the atlas</a></span>
      </figcaption>
    </figure>

    <div class="d-body wrap-wide">
      <aside class="specimen" aria-label="Specimen card">
        <dl>
          <div><dt>Field</dt><dd><a href={`/fields/${d.field.id}/`}>{fieldName(d.field.id)}</a></dd></div>
          {d.fields.length > 0 && <div><dt>Also in</dt><dd>{d.fields.map((f, i) => <>{i > 0 && ", "}<a href={`/fields/${f.id}/`}>{fieldName(f.id)}</a></>)}</dd></div>}
          <div><dt>Status</dt><dd><StatusPill status={d.status} /></dd></div>
          <div><dt>Started</dt><dd><time datetime={iso(d.started)}>{fullDate(d.started)}</time></dd></div>
          <div><dt>Last tended</dt><dd><time datetime={iso(updated)}>{fullDate(updated)}</time></dd></div>
          {d.stack.length > 0 && <div><dt>Tools</dt><dd>{d.stack.join(" · ")}</dd></div>}
          {d.tags.length > 0 && (
            <div><dt>Tags</dt><dd><ul class="tags">{d.tags.map((t) => <li><a href={`/tags/${slugify(t)}/`}>{t}</a></li>)}</ul></dd></div>
          )}
        </dl>
        {toc.length >= 4 && (
          <nav class="toc" aria-label="Contents">
            <p class="mono">Contents</p>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
      </aside>

      <div class="prose">
        <Content components={mdx} />

        {logs.length > 0 && (
          <section class="journal" aria-labelledby="journal-title">
            <h2 id="journal-title">From the build log</h2>
            <ol>
              {logs.map((l) => (
                <li>
                  <p class="mono"><time datetime={iso(l.data.date)}>{shortDate(l.data.date)}</time>{l.data.sample && <> · <span class="sample-stamp">Sample</span></>}</p>
                  <p class="j-title"><a href={`/logs/${l.id}/`}>{l.data.title}</a></p>
                  <p class="j-sum">{l.data.summary}</p>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>
    </div>

    {threads.length > 0 && (
      <section class="threads wrap" aria-labelledby="threads-title">
        <div class="section-head">
          <h2 id="threads-title">Threads from this star</h2>
          <a class="more" href={`/#no-${String(d.no).padStart(2, "0")}`}>Back to the atlas →</a>
        </div>
        <ul>
          {threads.map((t) => {
            const s = atlas.stars.find((x) => x.id === t.id)!;
            return (
              <li>
                <svg viewBox="-20 -20 40 40" aria-hidden="true" class:list={["t-glyph", { coral: s.glyph === "bench" }]}><StarGlyph glyph={s.glyph} r={8} /></svg>
                <div>
                  <p class="mono">{no(t.data.no)} · {fieldName(t.data.field.id)}{relatedIds.has(t.id) ? " · related" : " · same constellation"}</p>
                  <p class="t-title"><a href={`/projects/${t.id}/`}>{t.data.title}</a></p>
                  <p class="t-dek">{t.data.dek}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </article>
</Base>

<style>
  .d-head { padding: clamp(1.75rem, 5vw, 3.5rem) 0 clamp(1.5rem, 4vw, 2.5rem); }
  .crumbs { display: flex; gap: 0.6rem; margin: 0 0 clamp(1.5rem, 4vw, 2.5rem); }
  .crumbs a { display: inline-block; padding-block: 0.5rem; }
  .d-title-row { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: 0 1.5rem; align-items: start; }
  .d-glyph svg { width: 4.5rem; height: 4.5rem; color: var(--chart-ink); overflow: visible; margin-top: 0.3rem; }
  .d-glyph :global(.glyph-bench) { color: var(--coral); }
  .catalogue { margin: 0 0 0.9rem; display: flex; flex-wrap: wrap; gap: 0.2rem 0.45rem; align-items: center; }
  .d-title { font-family: var(--serif); font-weight: 300; font-size: clamp(2.6rem, 1.3rem + 5.2vw, 5.6rem); line-height: 0.98; letter-spacing: -0.025em; margin: 0 0 1rem; text-wrap: balance; max-width: 16ch; }
  .d-dek { font-family: var(--serif); font-style: italic; font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem); line-height: 1.35; color: var(--muted); max-width: 40rem; margin: 0 0 1rem; text-wrap: pretty; }
  .byline { margin: 0; }
  .byline a { color: var(--ink); }
  .d-links { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1.4rem 0 0; }
  .go-btn { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0.4rem 1.1rem; border: 1.5px solid var(--edge); font-family: var(--mono); font-size: 0.88rem; color: var(--ink); background: var(--surface); transition: border-color 0.2s, color 0.2s; }
  .go-btn b { font-weight: 400; transition: transform 0.25s ease; }
  .go-btn:hover, .go-btn:focus-visible { border-color: var(--accent); color: var(--accent); }
  .go-btn:hover b { transform: translate(2px, -2px); }
  .d-track { margin-top: clamp(1.75rem, 4vw, 2.75rem); max-width: 46rem; padding-left: 6rem; }

  .d-hero { margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .d-hero .plate { display: grid; place-items: center; }
  .d-hero img { max-height: 72vh; width: auto; max-width: 100%; }
  .d-hero.pixel img { width: 100%; height: auto; max-height: none; object-fit: contain; }
  .d-hero :global(.hero-sky) { aspect-ratio: 2.4; }
  @media (max-width: 40rem) { .d-hero :global(.hero-sky) { aspect-ratio: 1.35; } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .d-hero .plate > * { animation: hero-drift linear both; animation-timeline: view(); animation-range: exit 0% exit 100%; }
      @keyframes hero-drift { to { transform: translateY(6%) scale(1.03); } }
    }
  }

  .d-body { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: 0 clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .specimen { position: sticky; top: 1.5rem; padding-top: 0.9rem; border-top: 1px solid var(--edge); font-size: 0.92rem; }
  .specimen dl { margin: 0; display: grid; gap: 0.75rem; }
  .specimen dt { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); letter-spacing: 0.02em; }
  .specimen dd { margin: 0.1rem 0 0; }
  .toc { margin-top: 1.5rem; padding-top: 0.9rem; border-top: 1px solid var(--rule); }
  .toc p { margin: 0 0 0.4rem; }
  .toc ol { margin: 0; padding-left: 1.1rem; font-size: 0.92rem; }
  .toc li { padding-block: 0.15rem; }

  .prose { max-width: 40rem; counter-reset: fig 1; min-width: 0; }
  .prose :global(> p), .prose :global(> ul), .prose :global(> ol) { font-size: clamp(1.08rem, 1rem + 0.25vw, 1.2rem); line-height: 1.7; }
  .prose :global(> p:first-child) { font-family: var(--serif); font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.55rem); line-height: 1.5; margin-top: 0; }
  .prose :global(h2) { font-family: var(--serif); font-weight: 400; font-size: clamp(1.7rem, 1.35rem + 1.3vw, 2.3rem); line-height: 1.1; letter-spacing: -0.01em; margin: 3.25rem 0 1rem; padding-top: 1rem; border-top: 1px solid var(--rule); scroll-margin-top: 1.5rem; }
  .prose :global(h3) { font-family: var(--serif); font-weight: 500; font-size: 1.35rem; margin: 2.2rem 0 0.6rem; }
  .prose :global(li) { margin-bottom: 0.35rem; }
  .prose :global(strong) { font-weight: 650; }
  .prose :global(code:not(pre code)) { font-family: var(--mono); font-size: 0.86em; background: var(--paper-deep); padding: 0.08em 0.35em; border-radius: 3px; }
  .prose :global(pre) { font-family: var(--mono); font-size: 0.86rem; line-height: 1.6; padding: 1.15rem 1.25rem; border: 1px solid var(--rule); overflow-x: auto; margin: 2rem 0; tab-size: 2; }
  .prose :global(.d-fig) { margin: 2.25rem 0; counter-increment: fig; }
  .prose :global([data-fig-num])::before { content: "Fig. " counter(fig); }
  .prose :global(.wide) { width: min(100%, 52rem); max-width: none; }
  @media (min-width: 84rem) { .prose :global(.wide) { width: calc(100% + 12rem); } }
  .prose :global(blockquote) { margin: 2rem 0; padding-left: 1.2rem; border-left: 2px solid var(--coral); font-family: var(--serif); font-style: italic; font-size: 1.35rem; }

  .journal { margin-top: 3.5rem; }
  .journal ol { list-style: none; padding: 0; margin: 0; }
  .journal li { padding: 0.9rem 0; border-bottom: 1px solid var(--rule); }
  .journal li p { margin: 0; }
  .j-title { font-family: var(--serif); font-size: 1.3rem; margin: 0.15rem 0 0.2rem !important; }
  .j-sum { color: var(--muted); font-size: 1rem; }

  .threads { margin-top: clamp(3.5rem, 8vw, 5.5rem); }
  .threads ul { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 0.25rem 2rem; }
  .threads li { display: grid; grid-template-columns: 2.25rem 1fr; gap: 0.9rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  .threads li p { margin: 0; }
  .t-glyph { width: 2.25rem; height: 2.25rem; color: var(--chart-ink); overflow: visible; margin-top: 0.2rem; }
  .t-glyph.coral { color: var(--coral); }
  .t-title { font-family: var(--serif); font-size: 1.3rem; line-height: 1.2; margin: 0.15rem 0 0.25rem !important; }
  .t-dek { color: var(--muted); font-size: 0.98rem; }

  @media (max-width: 60rem) {
    .d-body { grid-template-columns: 1fr; }
    .specimen { position: static; margin-bottom: 2rem; }
    .specimen dl { grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: 0.75rem 1.5rem; }
    .toc { display: none; }
    .d-track { padding-left: 0; }
  }
  @media (max-width: 40rem) {
    .d-title-row { grid-template-columns: 1fr; }
    .d-glyph svg { width: 3rem; height: 3rem; margin: 0 0 0.75rem; }
  }
</style>
